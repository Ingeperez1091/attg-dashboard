# Security: enforce lockfile integrity for supply-chain protection.
# This prevents attacks via modified lockfiles that pull different package versions.

# Require package-lock.json to be in sync with package.json
package-lock=true

# Enforce exact versions from lockfile during installs (npm ci behavior)
# Prevents accidental resolution of different dependency versions
prefer-dedupe=true

# Security: lifecycle scripts from dependencies are allowed by default
# because @playwright/test and other tools require postinstall.
# CI pipelines should use `npm ci --ignore-scripts` where possible and
# run trusted postinstall steps explicitly afterward.
