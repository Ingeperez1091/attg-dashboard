# Production environment configuration for Next.js
# Loaded automatically when NODE_ENV=production (npm run build / npm start).
#
# DO NOT store secrets in this file. This file is committed to source control.
# Provide secrets via Azure App Service application settings or Azure Key Vault references.

# ─── Repository mode ────────────────────────────────────────────────────────
# Always use the SQL database in production. Never use in-memory repositories.
USE_INMEMORY_REPOSITORY=false

# ─── SQL connection ──────────────────────────────────────────────────────────
# Provide these via Azure App Service application settings (or DATABASE_URL).
# Option A – discrete variables (SQL auth):
SQL_SERVER=
SQL_INSTANCE=
SQL_PORT=1433
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=true
TRUSTED_CONNECTION=false
# Option B – single connection string (takes precedence over SQL_* vars):
# DATABASE_URL=Server=tcp:<server>,1433;Database=<db>;User Id=<user>;Password=<pass>;Encrypt=True;

# ─── Auth.js / Microsoft Entra ID ────────────────────────────────────────────
# AUTH_SECRET must be a cryptographically random string (32+ bytes).
# AUTH_URL must be the canonical HTTPS origin of the deployed app.
AUTH_URL=
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# ─── Dev bypass (disabled in production) ─────────────────────────────────────
# These are hardcoded off in production by the runtime security guard,
# but we set them explicitly to document the intent.
ENABLE_DEV_BYPASS=false
PIPELINE_EXECUTION_MODE=local
# DEV_SESSION_USER_ID must NOT be set in production.

# ─── Application Insights ────────────────────────────────────────────────────
# Provide via Azure App Service application settings or Key Vault reference.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Pipeline execution ───────────────────────────────────────────────────────
# Set to "adf" to trigger Azure Data Factory pipelines, "local" for in-process.
PIPELINE_EXECUTION_MODE=adf
ADF_PIPELINE_TRIGGER_ENDPOINT=
ADF_PIPELINE_TRIGGER_TOKEN=
